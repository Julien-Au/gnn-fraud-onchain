# Copy to .env and fill in. .env is gitignored and MUST NEVER be committed.
#
# Etherscan API key (free tier). Only needed for the OPTIONAL on-chain
# ingestion extension (real Ethereum data). Respect the documented rate limit
# (see data/DATA_CARD.md). Not required for the Elliptic datasets, which are
# packaged and downloaded through PyTorch Geometric.
ETHERSCAN_API_KEY=

# Google Cloud project id, only for the OPTIONAL BigQuery public-dataset path
# (crypto_ethereum / crypto_bitcoin). Not required for the default pipeline.
GCP_PROJECT_ID=
